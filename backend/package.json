{
  "name": "answershare-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run test:keys && npm run test:prompts && npm run test:engines && npm run test:matcher && npm run test:metrics && npm run test:eval",
    "test:keys": "tsx test/keys.test.ts",
    "test:prompts": "tsx test/prompts.test.ts",
    "test:engines": "tsx test/engines.test.ts",
    "test:matcher": "tsx test/matcher.test.ts",
    "test:metrics": "tsx test/metrics.test.ts",
    "test:eval": "tsx test/eval.test.ts",
    "test:eval:live": "tsx test/eval.test.ts --live",
    "test:foundation": "tsx test/foundation.test.ts",
    "test:pipeline": "tsx test/pipeline.test.ts",
    "test:live": "npm run test:foundation && npm run test:pipeline",
    "seed": "tsx scripts/seed-demo.ts",
    "start-run": "tsx scripts/start-run.ts",
    "run-now": "tsx scripts/run-now.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1164.0",
    "@aws-sdk/client-dynamodb": "^3.1164.0",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/client-scheduler": "^3.1164.0",
    "@aws-sdk/client-ssm": "^3.1164.0",
    "@aws-sdk/lib-dynamodb": "^3.1164.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-lambda": "^3.1164.0",
    "@aws-sdk/client-sfn": "^3.1164.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
