# Receives budget, DLQ and run-failure alerts, plus digests for workspaces without an owner email
ALERT_EMAIL=you@example.com
# SES-verified sender for the run digest (defaults to ALERT_EMAIL)
# DIGEST_FROM=you@example.com
# OpenAI model used with the web_search tool
OPENAI_MODEL=gpt-5-mini
# Hard cap on prompts x engines x samples per run
MAX_CALLS_PER_RUN=300
# Name shown on the hosted /guides pages (optional)
GUIDES_SITE_NAME=Acme Pay
